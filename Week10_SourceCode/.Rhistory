install.packages("ggplot2")
source("~/week9_regression.R")
source("~/week9_regression.R")
cor(cars$speed, cars$dist)
cor.test(cars$speed, cars$dist)
ggplot(cars, aes(x = speed, y = dist)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE) +
labs(title = "Stopping distance rises with speed",
x = "Speed (mph)",
y = "Stopping distance (ft)")
str(cars)        # 50 observations of speed (mph) and stopping distance (ft)
summary(cars)    # Speed ranges from 4 to 25 mph
cor(cars$speed, cars$dist)
cor.test(cars$speed, cars$dist)
ggplot(cars, aes(x = speed, y = dist)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE) +
labs(title = "Stopping distance rises with speed",
x = "Speed (mph)",
y = "Stopping distance (ft)")
cor(cars$speed, cars$dist)
cor.test(cars$speed, cars$dist)
cor(cars$speed, cars$dist)
cor.test(cars$speed, cars$dist)
fit <- lm(dist ~ speed, data = cars)
summary(fit)
confint(fit)
cor(cars$speed, cars$dist)
cor.test(cars$speed, cars$dist)
cars$fitted <- fitted(fit)
cars$resid  <- resid(fit)
ggplot(cars, aes(x = fitted, y = resid)) +
geom_point() +
geom_hline(yintercept = 0, linetype = "dashed") +
labs(title = "Residuals against fitted values",
x = "Fitted stopping distance (ft)",
y = "Residual (ft)")
dev.off()
head(cars)
ggplot(cars, aes(x = fitted, y = resid)) +
geom_point() +
geom_hline(yintercept = 0, linetype = "dashed") +
labs(title = "Residuals against fitted values",
x = "Fitted stopping distance (ft)",
y = "Residual (ft)")
ggplot(cars, aes(x = fitted, y = resid)) +
geom_point() +
geom_hline(yintercept = 0, linetype = "dashed") +
labs(title = "Residuals against fitted values",
x = "Fitted stopping distance (ft)",
y = "Residual (ft)")
predict(fit, newdata = data.frame(speed = 15), interval = "prediction")
predict(fit, newdata = data.frame(speed = 15), interval = "prediction")
